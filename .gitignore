# Build output
bin/
obj/

# Generated against YOUR install by `ppcli.ps1 index`: it carries that install's mods and pins that
# install's game build, so it is never published. aliases.ndjson is curated by hand and is committed.
catalog/defs.ndjson
catalog/meta.json

# Written by `deploy` with THIS machine's install path. Read by paths.ps1, never shipped.
ppcli-install.txt

# Game and client runtime droppings
Console.log
*.tmp
