{
  "//": "THE COMPOSITE: from a named snapshot, restore it, put a chosen enemy composition at a chosen distance with chosen equipment, and hand back what the situation actually became.",
  "//run": ".\\ppcli.ps1 plan .\\plans\\situation.json '{\"snapshot\":\"SAVE_NAME\",\"defName\":\"Crabman_Gunner_TacCharacterDef\",\"faction\":\"alien\",\"count\":3,\"minDistance\":9.0,\"maxDistance\":11.0,\"itemName\":\"PX_AssaultRifle_WeaponDef\"}'",
  "//already-there": "restoreFirst false skips the load and builds the situation in the mission that is already open. That is the fully verified path - see the status note below.",

  "//status": "PARTLY VERIFIED. The spawn-with-distance loop and the equip step are the SAME steps as spawn-squad.json and equip-actor.json, both proven in-game 2026-08-25 (3 Crabmen at 10.47 / 9.00 / 10.00 m, rifle confirmed by an independent read of the actor's Equipments). The restore head was NOT proven: the session's game process died mid-load. Run it with restoreFirst false to stay on proven ground.",

  "//no-nesting": "The engine forbids a plan running a plan, so the spawn body below is spawn-squad.json's, inlined. Keep the two in step: a fix in one belongs in the other.",

  "timeoutMs": 540000,
  "maxSteps": 1600,

  "vars": {
    "snapshot": "SAVE_NAME",
    "restoreFirst": true,
    "defName": "Crabman_Gunner_TacCharacterDef",
    "faction": "alien",
    "count": 3,
    "minDistance": 9.0,
    "maxDistance": 11.0,
    "itemName": "PX_AssaultRifle_WeaponDef",
    "equip": true,
    "useCenter": false,
    "centerX": 0.0,
    "centerY": 0.0,
    "centerZ": 0.0,
    "probeY": 2.0,
    "snapRadius": 0.5,
    "readyTimeoutMs": 420000,
    "inPlayTimeoutMs": 5000,
    "preloadTimeoutMs": 60000
  },

  "steps": [
    { "//": "Issue-only: load_game hands back no completion signal (SerializationCommands.cs:44). The next step is the completion protocol.",
      "id": "restore", "verb": "restore", "if": "${restoreFirst}", "args": { "name": "${snapshot}" } },
    { "id": "mission-ready", "verb": "wait", "args": { "ready": true, "timeoutMs": "${readyTimeoutMs}" } },

    { "//": "A live AI turn walks the anchor away between round-trips.",
      "id": "freeze-ai", "verb": "var", "args": { "name": "ai_enabled", "value": "false" } },

    { "id": "anchor-selected", "verb": "call", "save": "ANCHOR", "unless": "${useCenter}",
      "args": { "op": "get", "target": "@selected", "member": "Pos" } },
    { "id": "anchor-explicit", "verb": "call", "save": "ANCHOR", "if": "${useCenter}",
      "args": { "op": "new", "type": "UnityEngine.Vector3", "args": [ "${centerX}", "${centerY}", "${centerZ}" ] } },

    { "id": "find-def", "verb": "find", "save": "DEF",
      "args": { "query": "${defName}", "type": "PhoenixPoint.Tactical.Entities.TacActorDef" } },
    { "id": "find-item", "verb": "find", "save": "ITEM", "if": "${equip}",
      "args": { "query": "${itemName}", "type": "PhoenixPoint.Common.Entities.Items.ItemDef" } },

    { "//PRELOAD": "MANDATORY, and the reason a squad used to spawn INVISIBLE. `spawn` runs its whole spawn inside the loading callback (TacticalDeployZone.cs:424 -> :409-423) and `give_item` preloads its item def the same way (TacConsoleGameplay.cs:770). Assets are per-DEF - skipping this only looked safe when the def was already on the map.",
      "id": "assets-loader", "verb": "call", "save": "AL",
      "args": { "op": "get", "target": "@tac", "member": "AssetsLoader" } },
    { "//": "LoadRoots (AssetsReferencesLoader.cs:71) not StartLoadingRoots (:58): same acquisition, still owned by the level's loader, but an iterator that ends when loading does. Two variants because the item def is only in the set when `equip` is on.",
      "id": "preload-crt", "verb": "call", "save": "CRT", "if": "${equip}",
      "args": { "op": "invoke", "target": "${AL.value.h}", "member": "LoadRoots",
                "args": [ [ { "$def": "${DEF.defs[0].guid}" }, { "$def": "${ITEM.defs[0].guid}" } ],
                          "ppcli situation" ] } },
    { "id": "preload-crt-noitem", "verb": "call", "save": "CRT", "unless": "${equip}",
      "args": { "op": "invoke", "target": "${AL.value.h}", "member": "LoadRoots",
                "args": [ [ { "$def": "${DEF.defs[0].guid}" } ], "ppcli situation" ] } },
    { "id": "loader-timing", "verb": "call", "save": "TIM",
      "args": { "op": "get", "target": "${AL.value.h}", "member": "Timing" } },
    { "//": "Timing.Start (Timing.cs:246) -> the IUpdateable whose Stopped is a POSITIVE single-call predicate; the engine has no `not` and both IsLoading surfaces are wrong-polarity and loader-global. Trailing null = the optional catchException, arity matched exactly.",
      "id": "preload-start", "verb": "call", "save": "UPD",
      "args": { "op": "invoke", "target": "${TIM.value.h}", "member": "Start",
                "args": [ { "$h": "${CRT.value.h}" }, null ] } },
    { "//": "ASYNCHRONOUS - spawning on the next round-trip waits for nothing.",
      "id": "preload-done", "verb": "wait",
      "args": { "timeoutMs": "${preloadTimeoutMs}", "everyFrames": 2,
                "call": { "op": "get", "target": "${UPD.value.h}", "member": "Stopped" } } },

    { "id": "deploy-data", "verb": "call", "save": "DD",
      "args": { "op": "new", "type": "PhoenixPoint.Common.Levels.ActorDeployment.ActorDeployData",
                "args": [ { "$def": "${DEF.defs[0].guid}" } ] } },
    { "id": "init-instance", "verb": "call",
      "args": { "op": "invoke", "target": "${DD.value.h}", "member": "InitializeInstanceData", "args": [] } },
    { "id": "component-set", "verb": "call", "save": "CSD",
      "args": { "op": "get", "target": "${DD.value.h}", "member": "ComponentSetDef" } },
    { "id": "instance-data", "verb": "call", "save": "INST",
      "args": { "op": "get", "target": "${DD.value.h}", "member": "InstanceData" } },

    { "id": "faction", "verb": "call", "save": "FAC",
      "args": { "op": "invoke", "target": "@tac", "member": "GetFactionByCommandName", "args": [ "${faction}" ] } },
    { "id": "faction-def", "verb": "call", "save": "FACDEF",
      "args": { "op": "get", "target": "${FAC.value.h}", "member": "TacticalFactionDef" } },
    { "id": "participant", "verb": "call", "save": "PART",
      "args": { "op": "get", "target": "${FAC.value.h}", "member": "ParticipantKind" } },

    { "id": "floor-mask", "verb": "call", "save": "MASK",
      "args": { "op": "get", "type": "PhoenixPoint.Common.Utils.UnityLayers", "member": "FloorAllMask" } },
    { "id": "nav-def", "verb": "call", "save": "NAV",
      "args": { "op": "invoke", "target": "${CSD.value.h}", "member": "GetComponentDef",
                "typeArgs": [ "PhoenixPoint.Tactical.Entities.TacticalNavigationComponentDef" ], "args": [] } },
    { "id": "perception-def", "verb": "call", "save": "PERC",
      "args": { "op": "invoke", "target": "${CSD.value.h}", "member": "GetComponentDef",
                "typeArgs": [ "PhoenixPoint.Tactical.Entities.TacticalPerceptionDef" ], "args": [] } },

    { "id": "ring", "verb": "call", "save": "RING",
      "args": { "op": "invoke", "type": "PhoenixPoint.Tactical.Levels.TacticalMap", "member": "GetPositionsInRange",
                "args": [ { "$v3": [ "${ANCHOR.value.x}", "${ANCHOR.value.y}", "${ANCHOR.value.z}" ] },
                          "${minDistance}", "${maxDistance}" ] } },
    { "id": "pool", "verb": "call", "save": "POOL",
      "args": { "op": "invoke", "type": "System.Linq.Enumerable", "member": "ToList",
                "typeArgs": [ "UnityEngine.Vector3" ], "args": [ { "$h": "${RING.value.h}" } ] } },
    { "id": "log", "verb": "call", "save": "LOG",
      "args": { "op": "new", "type": "System.Collections.ArrayList", "args": [ 16 ] } },

    { "id": "squad", "verb": "repeat",
      "args": {
        "times": 12,
        "while": "${MORE.value}",
        "steps": [
          { "id": "search", "verb": "repeat",
            "args": {
              "times": 12,
              "while": "${NOTSTAND.value}",
              "steps": [
                { "id": "pick", "verb": "call", "save": "RAW",
                  "args": { "op": "invoke", "type": "Base.UnityUtil", "member": "GetRandomElement",
                            "typeArgs": [ "UnityEngine.Vector3" ], "args": [ { "$h": "${POOL.value.h}" }, null ] } },
                { "id": "snap", "verb": "call", "save": "POS",
                  "args": { "op": "invoke", "target": "@map", "member": "SnapXYZ",
                            "args": [ { "$v3": [ "${RAW.value.x}", "${probeY}", "${RAW.value.z}" ] },
                                      { "$h": "${MASK.value.h}" }, "${snapRadius}", true ] } },
                { "id": "stand", "verb": "call", "save": "STAND",
                  "args": { "op": "invoke", "target": "@map", "member": "CanStandAt",
                            "args": [ { "$h": "${NAV.value.h}" }, { "$h": "${PERC.value.h}" },
                                      { "$v3": [ "${POS.value.x}", "${POS.value.y}", "${POS.value.z}" ] } ] } },
                { "id": "not-stand", "verb": "call", "save": "NOTSTAND",
                  "args": { "op": "invoke", "type": "System.Object", "member": "Equals",
                            "args": [ false, "${STAND.value}" ] } }
              ] } },

          { "id": "assert-standable", "verb": "wait",
            "args": { "timeoutMs": 1, "everyFrames": 1,
                      "call": { "op": "invoke", "target": "@map", "member": "CanStandAt",
                                "args": [ { "$h": "${NAV.value.h}" }, { "$h": "${PERC.value.h}" },
                                          { "$v3": [ "${POS.value.x}", "${POS.value.y}", "${POS.value.z}" ] } ] } } },

          { "id": "spawn", "verb": "call", "save": "ACTOR",
            "args": { "op": "invoke", "type": "PhoenixPoint.Tactical.Levels.ActorDeployment.TacticalDeployZone",
                      "member": "SpawnActor",
                      "args": [ { "$h": "${CSD.value.h}" }, { "$h": "${INST.value.h}" }, { "$h": "${FACDEF.value.h}" },
                                "${PART.value}",
                                { "$v3": [ "${POS.value.x}", "${POS.value.y}", "${POS.value.z}" ] },
                                { "$quat": [ 0, 0, 0, 1 ] }, null ] } },
          { "id": "source", "verb": "call",
            "args": { "op": "set", "target": "${ACTOR.value.h}", "member": "Source", "value": { "$h": "${ACTOR.value.h}" } } },
          { "id": "in-play", "verb": "wait",
            "args": { "timeoutMs": "${inPlayTimeoutMs}", "everyFrames": 2,
                      "call": { "op": "get", "target": "${ACTOR.value.h}", "member": "InPlay" } } },

          { "//": "THE EQUIPMENT, post-spawn. Setting TacActorInstanceData.EquipmentItems before the spawn (api-map s2b) would also work and would suppress the def's own loadout; this ADDS to it, which is what a 'give them a rifle too' situation usually means.",
            "id": "hands", "verb": "call", "save": "EQ", "if": "${equip}",
            "args": { "op": "get", "target": "${ACTOR.value.h}", "member": "Equipments" } },
          { "id": "give", "verb": "call", "save": "GIVEN", "if": "${equip}",
            "args": { "op": "invoke", "target": "${EQ.value.h}", "member": "AddItem",
                      "args": [ { "$def": "${ITEM.defs[0].guid}" }, null ] } },

          { "id": "achieved", "verb": "call", "save": "ACH",
            "args": { "op": "get", "target": "${ACTOR.value.h}", "member": "Pos" } },
          { "id": "achieved-distance", "verb": "call", "save": "DIST",
            "args": { "op": "invoke", "type": "UnityEngine.Vector3", "member": "Distance",
                      "args": [ { "$v3": [ "${ANCHOR.value.x}", "${ANCHOR.value.y}", "${ANCHOR.value.z}" ] },
                                { "$v3": [ "${ACH.value.x}", "${ACH.value.y}", "${ACH.value.z}" ] } ] } },
          { "id": "record", "verb": "call",
            "args": { "op": "invoke", "target": "${LOG.value.h}", "member": "Add",
                      "args": [ "${ACTOR.value.name} at ${ACH.value.x},${ACH.value.y},${ACH.value.z} dist=${DIST.value}" ] } },

          { "id": "spawned-so-far", "verb": "call", "save": "DONE",
            "args": { "op": "get", "target": "${LOG.value.h}", "member": "Count" } },
          { "id": "more", "verb": "call", "save": "MORE",
            "args": { "op": "invoke", "type": "Base.Utils.Maths.Utl", "member": "LesserThan",
                      "args": [ "${DONE.value}", "${count}", 0.01 ] } }
        ] } },

    { "id": "situation-cache", "verb": "call", "save": "SC",
      "args": { "op": "get", "target": "@tac", "member": "SituationCache" } },
    { "id": "invalidate-cache", "verb": "call",
      "args": { "op": "invoke", "target": "${SC.value.h}", "member": "Invalidate", "args": [] } },
    { "//": "COSMETIC TAIL, onError:continue on purpose. It re-runs selection, which asks the navmesh for a path; while the map rebuilds (in-combat explosions) it throws 'Map is updating, cannot calculate path!'. The squad is already in play, so that is a WARNING (`selectionReset` in the output), never a FAILED verdict over completed work.",
      "id": "reset-selection", "verb": "call", "save": "RESET", "onError": "continue",
      "args": { "op": "invoke", "target": "@view", "member": "ResetCharacterSelectedState", "args": [] } },

    { "id": "read-log", "verb": "items", "save": "PLACED", "args": { "h": "${LOG.value.h}", "pageSize": 16 } },
    { "id": "state", "verb": "state", "save": "ST" }
  ],

  "finally": [
    { "//": "MANDATORY. ai_enabled is the one global this plan changes, so it is restored FIRST - a plan that dies with the AI off leaves the mission unplayable to a human.",
      "id": "restore-ai", "verb": "var", "args": { "name": "ai_enabled", "value": "true" } },
    { "id": "release-log", "verb": "release", "args": { "h": "${LOG.value.h}" } },
    { "id": "release-pool", "verb": "release", "args": { "h": "${POOL.value.h}" } },
    { "id": "release-ring", "verb": "release", "args": { "h": "${RING.value.h}" } },
    { "id": "release-mask", "verb": "release", "args": { "h": "${MASK.value.h}" } },
    { "id": "release-deploy-data", "verb": "release", "args": { "h": "${DD.value.h}" } },
    { "id": "release-situation-cache", "verb": "release", "args": { "h": "${SC.value.h}" } },
    { "//": "The preload intermediates only - the ASSETS stay held by the level's loader until teardown.",
      "id": "release-updateable", "verb": "release", "args": { "h": "${UPD.value.h}" } },
    { "id": "release-preload-crt", "verb": "release", "args": { "h": "${CRT.value.h}" } },
    { "id": "release-loader-timing", "verb": "release", "args": { "h": "${TIM.value.h}" } },
    { "id": "release-assets-loader", "verb": "release", "args": { "h": "${AL.value.h}" } }
  ],

  "output": {
    "snapshot": "${snapshot}",
    "scene": "${ST.scene}",
    "def": "${DEF.defs[0].name}",
    "faction": "${faction}",
    "item": "${itemName}",
    "anchor": "${ANCHOR.value}",
    "band": "${minDistance} - ${maxDistance}",
    "candidates": "${POOL.value.count}",
    "requested": "${count}",
    "spawned": "${DONE.value}",
    "placed": "${PLACED.items}",
    "selectionReset": "${RESET.ok}"
  }
}
