{
  "//": "COLD START with FULL PARTICIPANT CONTROL: choose the map, the mission type, who is in it and how big the player's squad is - including NO squad at all - from the main menu, with no campaign.",
  "//run": ".\\ppcli.ps1 plan .\\plans\\build-mission.json '{\"scene\":\"ALN_PLT_Nest_48x48_A\",\"playerCount\":2,\"playerCharacterDefName\":\"PX_Assault1_Base_TacCharacterDef\"}'",
  "//vs-start-mission": "start-mission.json is the ONE-STEP version: `loadmap` builds the TacMissionData off the plot's own TacticalLevelParamsDef and you get whatever that shipped with. This plan builds the TacMissionData itself (TacMissionData.cs:19-70), so the roster is yours. Same lever at the end - LoadLevelGameResult + FinishLevel, exactly what loadmap does (MapPlot.cs:356-365).",
  "//empty-squad": "playerCount 0 gives the player faction an EMPTY roster. That is a supported shape, not a trick - TFTV builds base-defence missions that way (TFTVBaseDefenseGeoscape.cs:3534).",
  "//intruders": "The intruder side is given deployment POINTS and an empty explicit roster, so the game's own deployment picks the force. An explicit intruder roster would be the same repeat as the player one; add it when a run needs a named enemy.",
  "//names": "PPFactionDef: Phoenix_FactionDef, Alien_FactionDef, NewJericho_FactionDef, Synedrion_FactionDef, Anu_FactionDef, NEU_Bandits_FactionDef, Environment_FactionDef, WildBeast_FactionDef, Ancients_FactionDef. Mission types are the catalog's `mission-type` family (*_CustomMissionTypeDef).",

  "timeoutMs": 600000,
  "maxSteps": 300,

  "vars": {
    "scene": "ALN_PLT_Nest_48x48_A",
    "seed": 12345,
    "missionTypeDefName": "AmbushAlien_CustomMissionTypeDef",
    "playerFactionDefName": "Phoenix_FactionDef",
    "playerCharacterDefName": "PX_Assault1_Base_TacCharacterDef",
    "playerCount": 2,
    "intruderFactionDefName": "Alien_FactionDef",
    "intruderPoints": 2000,
    "intruderReinforcements": 0,
    "intruderReinforcementTurns": 0,
    "waitReady": false,
    "menuTimeoutMs": 120000,
    "loadTimeoutMs": 420000
  },

  "steps": [
    { "//": "SAME HEAD AS start-mission.json - see its comments, including why a live geoscape is refused.",
      "id": "phase", "verb": "state", "save": "ST0" },
    { "//": "See start-mission.json's `is-geoscape` for why these two steps exist and what wedges without them.",
      "id": "is-geoscape", "verb": "call", "save": "ISGEO",
      "args": { "op": "invoke", "type": "System.Object", "member": "Equals", "args": [ "geoscape", "${ST0.phase}" ] } },
    { "id": "geo-view", "verb": "call", "save": "GEOVIEW", "if": "${ISGEO.value}",
      "args": { "op": "get", "target": "@geo", "member": "View" } },
    { "id": "geo-stack-off", "verb": "call", "if": "${ISGEO.value}",
      "args": { "op": "set", "target": "${GEOVIEW.value.h}", "member": "UpdateStateStack", "value": false } },
    { "id": "geo-to-loading", "verb": "call", "if": "${ISGEO.value}",
      "args": { "op": "invoke", "target": "${GEOVIEW.value.h}", "member": "ToLoadingState", "args": [] } },
    { "id": "is-menu", "verb": "call", "save": "ISMENU",
      "args": { "op": "invoke", "type": "System.Object", "member": "Equals", "args": [ "menu", "${ST0.phase}" ] } },
    { "id": "in-level", "verb": "call", "save": "INLEVEL",
      "args": { "op": "invoke", "type": "System.Object", "member": "Equals", "args": [ false, "${ISMENU.value}" ] } },
    { "id": "to-menu", "verb": "call", "if": "${INLEVEL.value}",
      "args": { "op": "invoke", "target": "@phoenix", "member": "FinishLevelAndGoToLobby", "args": [ 0 ] } },
    { "id": "at-menu", "verb": "wait", "args": { "phase": "menu", "timeoutMs": "${menuTimeoutMs}", "everyFrames": 10 } },
    { "id": "menu-level-up", "verb": "wait",
      "args": { "timeoutMs": "${menuTimeoutMs}", "everyFrames": 10,
                "call": { "op": "get", "target": "@level", "member": "IsPlaying" } } },

    { "//": "--- THE MISSION. MissionParticipants is a plain field and `new TacMissionData` leaves it null, so AddPlayer would NRE on the first Add.",
      "id": "mission", "verb": "call", "save": "MD",
      "args": { "op": "new", "type": "PhoenixPoint.Common.Levels.Missions.TacMissionData", "args": [] } },
    { "//": "The capacity ctor, not the empty one: `new List<T>()` ties against the static .cctor in this binder (the same reason spawn-squad.json builds its ArrayList with a capacity).",
      "id": "participants", "verb": "call", "save": "PARTS",
      "args": { "op": "new", "type": "System.Collections.Generic.List`1[[PhoenixPoint.Common.Levels.Missions.TacMissionFactionData, Assembly-CSharp]]", "args": [ 4 ] } },
    { "id": "set-participants", "verb": "call",
      "args": { "op": "set", "target": "${MD.value.h}", "member": "MissionParticipants", "value": { "$h": "${PARTS.value.h}" } } },
    { "id": "find-mission-type", "verb": "find", "save": "MT", "args": { "query": "${missionTypeDefName}" } },
    { "id": "mission-type", "verb": "call", "save": "MTD",
      "args": { "op": "invoke", "target": "@defs", "member": "GetDef", "args": [ "${MT.defs[0].guid}" ] } },
    { "id": "set-mission-type", "verb": "call",
      "args": { "op": "set", "target": "${MD.value.h}", "member": "MissionType", "value": { "$h": "${MTD.value.h}" } } },

    { "//": "--- THE PLAYER SQUAD. The list IS the loop counter: its own Count is both the index and the `while` guard, because the engine has no loop variable.",
      "id": "squad", "verb": "call", "save": "SQUAD",
      "args": { "op": "new", "type": "System.Collections.Generic.List`1[[PhoenixPoint.Common.Levels.ActorDeployment.ActorDeployData, Assembly-CSharp]]", "args": [ 8 ] } },
    { "//": "Computed BEFORE the loop so playerCount 0 never enters it - that is the empty-squad case.",
      "id": "more-0", "verb": "call", "save": "MORE",
      "args": { "op": "invoke", "type": "Base.Utils.Maths.Utl", "member": "LesserThan", "args": [ 0, "${playerCount}", 0.01 ] } },
    { "id": "find-character", "verb": "find", "save": "CH", "if": "${MORE.value}",
      "args": { "query": "${playerCharacterDefName}", "type": "PhoenixPoint.Tactical.Entities.TacCharacterDef" } },
    { "id": "character", "verb": "call", "save": "CHD", "if": "${MORE.value}",
      "args": { "op": "invoke", "target": "@defs", "member": "GetDef", "args": [ "${CH.defs[0].guid}" ] } },
    { "//": "`if` on the repeat ITSELF, not just `while`: the guard is only re-checked BETWEEN passes (Plan.cs:467), so a repeat always runs its body once - which with playerCount 0 meant reaching for a character def that was deliberately never looked up.",
      "id": "fill-squad", "verb": "repeat", "if": "${MORE.value}",
      "args": {
        "times": 12,
        "while": "${MORE.value}",
        "steps": [
          { "//": "TacCharacterDef.GenerateActorDeployData clones the character's data and rolls its progression, so every soldier is a distinct one.",
            "id": "deploy-data", "verb": "call", "save": "ADD",
            "args": { "op": "invoke", "target": "${CHD.value.h}", "member": "GenerateActorDeployData", "args": [] } },
          { "id": "add", "verb": "call",
            "args": { "op": "invoke", "target": "${SQUAD.value.h}", "member": "Add", "args": [ { "$h": "${ADD.value.h}" } ] } },
          { "id": "so-far", "verb": "call", "save": "SOFAR",
            "args": { "op": "get", "target": "${SQUAD.value.h}", "member": "Count" } },
          { "id": "more", "verb": "call", "save": "MORE",
            "args": { "op": "invoke", "type": "Base.Utils.Maths.Utl", "member": "LesserThan",
                      "args": [ "${SOFAR.value}", "${playerCount}", 0.01 ] } }
        ] } },

    { "id": "find-player-faction", "verb": "find", "save": "PF",
      "args": { "query": "${playerFactionDefName}", "type": "PhoenixPoint.Common.Core.PPFactionDef" } },
    { "id": "player-faction", "verb": "call", "save": "PFD",
      "args": { "op": "invoke", "target": "@defs", "member": "GetDef", "args": [ "${PF.defs[0].guid}" ] } },
    { "id": "add-player", "verb": "call",
      "args": { "op": "invoke", "target": "${MD.value.h}", "member": "AddPlayer",
                "args": [ { "$h": "${PFD.value.h}" }, { "$h": "${SQUAD.value.h}" } ] } },

    { "id": "find-intruder-faction", "verb": "find", "save": "IF",
      "args": { "query": "${intruderFactionDefName}", "type": "PhoenixPoint.Common.Core.PPFactionDef" } },
    { "id": "intruder-faction", "verb": "call", "save": "IFD",
      "args": { "op": "invoke", "target": "@defs", "member": "GetDef", "args": [ "${IF.defs[0].guid}" ] } },
    { "//": "An EMPTY explicit roster: the deployment points below are what the game turns into an actual force.",
      "id": "no-intruder-roster", "verb": "call", "save": "EMPTY",
      "args": { "op": "invoke", "type": "System.Linq.Enumerable", "member": "Empty",
                "typeArgs": [ "PhoenixPoint.Common.Levels.ActorDeployment.ActorDeployData" ], "args": [] } },
    { "//": "All six arguments: the binder matches arity exactly, so `infReinf`'s default cannot be omitted (TacMissionData.cs:62).",
      "id": "add-intruders", "verb": "call",
      "args": { "op": "invoke", "target": "${MD.value.h}", "member": "AddIntruders",
                "args": [ { "$h": "${IFD.value.h}" }, { "$h": "${EMPTY.value.h}" },
                          "${intruderPoints}", "${intruderReinforcements}", "${intruderReinforcementTurns}", false ] } },

    { "//": "--- THE BINDING, assembled exactly as loadmap assembles its own (MapPlot.cs:343-364).",
      "id": "params", "verb": "call", "save": "TGP",
      "args": { "op": "new", "type": "PhoenixPoint.Common.Levels.Params.TacticalGameParams", "args": [] } },
    { "id": "set-mission-data", "verb": "call",
      "args": { "op": "set", "target": "${TGP.value.h}", "member": "MissionData", "value": { "$h": "${MD.value.h}" } } },
    { "id": "plot-data", "verb": "call", "save": "MPG",
      "args": { "op": "new", "type": "PhoenixPoint.Common.Levels.MapGeneration.MapPlotGenerationData", "args": [] } },
    { "id": "set-seed", "verb": "call",
      "args": { "op": "set", "target": "${MPG.value.h}", "member": "RandomSeed", "value": "${seed}" } },
    { "id": "set-plot-data", "verb": "call",
      "args": { "op": "set", "target": "${TGP.value.h}", "member": "MapPlotGenerationData", "value": { "$h": "${MPG.value.h}" } } },

    { "id": "shared-data", "verb": "call", "save": "SD",
      "args": { "op": "invoke", "target": "@game", "member": "GetComponent",
                "typeArgs": [ "PhoenixPoint.Common.Core.SharedData" ], "args": [] } },
    { "id": "tactical-level-def", "verb": "call", "save": "TLD",
      "args": { "op": "get", "target": "${SD.value.h}", "member": "TacticalLevelDef" } },
    { "id": "binding", "verb": "call", "save": "BIND",
      "args": { "op": "new", "type": "Base.Levels.LevelSceneBinding", "args": [] } },
    { "id": "set-level-def", "verb": "call",
      "args": { "op": "set", "target": "${BIND.value.h}", "member": "LevelDef", "value": { "$h": "${TLD.value.h}" } } },
    { "id": "scenes", "verb": "call", "save": "SCENES",
      "args": { "op": "new", "type": "System.Collections.Generic.List`1[[Base.Core.SceneReference, Assembly-CSharp]]", "args": [ 1 ] } },
    { "id": "scene-ref", "verb": "call", "save": "SR",
      "args": { "op": "new", "type": "Base.Core.SceneReference", "args": [ "${scene}" ] } },
    { "id": "add-scene", "verb": "call",
      "args": { "op": "invoke", "target": "${SCENES.value.h}", "member": "Add", "args": [ { "$h": "${SR.value.h}" } ] } },
    { "id": "set-scenes", "verb": "call",
      "args": { "op": "set", "target": "${BIND.value.h}", "member": "LevelScenes", "value": { "$h": "${SCENES.value.h}" } } },
    { "id": "set-level-params", "verb": "call",
      "args": { "op": "set", "target": "${BIND.value.h}", "member": "LevelParams", "value": { "$h": "${TGP.value.h}" } } },

    { "//": "THE LEVER. MenuCrt branches on the params TYPE into TacticalGameCrt (PhoenixGame.cs:514-523).",
      "id": "result", "verb": "call", "save": "RES",
      "args": { "op": "new", "type": "PhoenixPoint.Common.Levels.Params.LoadLevelGameResult",
                "args": [ { "$h": "${BIND.value.h}" } ] } },
    { "id": "start", "verb": "call",
      "args": { "op": "invoke", "target": "@phoenix", "member": "FinishLevel", "args": [ { "$h": "${RES.value.h}" } ] } },

    { "id": "tactical", "verb": "wait", "args": { "phase": "tactical", "timeoutMs": "${loadTimeoutMs}", "everyFrames": 10 } },
    { "//": "OFF BY DEFAULT, and that is the finding: a mission with an EXPLICIT player roster stops in DEPLOYMENT and waits for the squad to be placed, so HasAnyTurnStarted stays false forever with nobody at the keyboard (measured 2026-08-28: level Playing, 4 factions, TurnNumber 0, `ready` still false after 420 s). start-mission.json can wait on it because loadmap's own MissionData deploys itself. Turn it on only for a build whose participants need no placement.",
      "id": "playable", "verb": "wait", "if": "${waitReady}",
      "args": { "ready": true, "timeoutMs": "${loadTimeoutMs}", "everyFrames": 10 } },
    { "id": "turn-started", "verb": "call", "save": "STARTED",
      "args": { "op": "get", "target": "@tac", "member": "HasAnyTurnStarted" } },

    { "//": "WHAT IT ACTUALLY BECAME - the same per-faction census start-mission.json reports.",
      "id": "factions", "verb": "call", "save": "FACS",
      "args": { "op": "get", "target": "@tac", "member": "Factions" } },
    { "id": "log", "verb": "call", "save": "LOG",
      "args": { "op": "new", "type": "System.Collections.ArrayList", "args": [ 8 ] } },
    { "id": "per-faction", "verb": "repeat",
      "args": {
        "times": 12,
        "while": "${FMORE.value}",
        "steps": [
          { "id": "index", "verb": "call", "save": "IDX",
            "args": { "op": "get", "target": "${LOG.value.h}", "member": "Count" } },
          { "id": "faction", "verb": "items", "save": "FPAGE",
            "args": { "h": "${FACS.value.h}", "page": "${IDX.value}", "pageSize": 1 } },
          { "id": "faction-def", "verb": "call", "save": "FDEF",
            "args": { "op": "get", "target": "${FPAGE.items[0].h}", "member": "TacticalFactionDef" } },
          { "id": "actors", "verb": "call", "save": "ACTS",
            "args": { "op": "get", "target": "${FPAGE.items[0].h}", "member": "Actors" } },
          { "id": "actor-count", "verb": "call", "save": "N",
            "args": { "op": "invoke", "type": "System.Linq.Enumerable", "member": "Count",
                      "typeArgs": [ "PhoenixPoint.Tactical.Entities.TacticalActorBase" ],
                      "args": [ { "$h": "${ACTS.value.h}" } ] } },
          { "id": "record", "verb": "call",
            "args": { "op": "invoke", "target": "${LOG.value.h}", "member": "Add",
                      "args": [ "${FDEF.value.name}: ${N.value}" ] } },
          { "id": "logged", "verb": "call", "save": "FSOFAR",
            "args": { "op": "get", "target": "${LOG.value.h}", "member": "Count" } },
          { "id": "fmore", "verb": "call", "save": "FMORE",
            "args": { "op": "invoke", "type": "Base.Utils.Maths.Utl", "member": "LesserThan",
                      "args": [ "${FSOFAR.value}", "${FACS.value.count}", 0.01 ] } }
        ] } },
    { "id": "read-log", "verb": "items", "save": "PER_FACTION", "args": { "h": "${LOG.value.h}", "pageSize": 12 } },
    { "id": "state", "verb": "state", "save": "ST" }
  ],

  "finally": [
    { "id": "release-log", "verb": "release", "args": { "h": "${LOG.value.h}" } },
    { "id": "release-factions", "verb": "release", "args": { "h": "${FACS.value.h}" } },
    { "id": "release-result", "verb": "release", "args": { "h": "${RES.value.h}" } },
    { "id": "release-binding", "verb": "release", "args": { "h": "${BIND.value.h}" } },
    { "id": "release-scenes", "verb": "release", "args": { "h": "${SCENES.value.h}" } },
    { "id": "release-params", "verb": "release", "args": { "h": "${TGP.value.h}" } },
    { "id": "release-plot-data", "verb": "release", "args": { "h": "${MPG.value.h}" } },
    { "id": "release-squad", "verb": "release", "args": { "h": "${SQUAD.value.h}" } },
    { "id": "release-participants", "verb": "release", "args": { "h": "${PARTS.value.h}" } },
    { "id": "release-mission", "verb": "release", "args": { "h": "${MD.value.h}" } },
    { "id": "release-shared-data", "verb": "release", "args": { "h": "${SD.value.h}" } }
  ],

  "output": {
    "scene": "${ST.scene}",
    "phase": "${ST.phase}",
    "missionType": "${missionTypeDefName}",
    "playerFaction": "${playerFactionDefName}",
    "requestedSquad": "${playerCount}",
    "intruderFaction": "${intruderFactionDefName}",
    "intruderPoints": "${intruderPoints}",
    "factions": "${FACS.value.count}",
    "turnStarted": "${STARTED.value}",
    "perFaction": "${PER_FACTION.items}"
  }
}
