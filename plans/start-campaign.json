{
  "//": "COLD START, geoscape. From the main menu of a game that has never played anything, begin a real campaign - factions, the starting base and the initial squad are all generated by the game itself.",
  "//run": ".\\ppcli.ps1 plan .\\plans\\start-campaign.json '{\"difficultyIndex\":1}'",
  "//needs": "NOTHING. Works from the HomeScreen; if a level is already open it closes it first.",
  "//why": "This is what makes the geoscape plans (set-resources.json, unlock-research.json, the geoscape half of load-mission.json) testable at all on an install that has never had a campaign.",

  "//recipe": "The main menu's own path, UIStateNewGeoscapeGameSettings.GameSettings_OnConfirm:103-152 and CreateSceneBinding:159-186 (non-tutorial branch). The one thing that must NOT be improvised is the params object: CLONE the game mode def's own GeoscapeGameParams (:114). A hand-built one has RedeemableCodes and EnabledDlc null, and GeoLevelController.LevelCrt reads both unguarded (:551,564).",
  "//difficulty": "SharedData.DifficultyLevels, by INDEX - the same array the menu shows. 0 is the easiest; the LAST entry is the one the menu refuses to combine with the tutorial. `difficulties` in the output says how many there are.",
  "//dlc": "EnabledDlc is left exactly as the def's clone has it. The menu overwrites it from the DLC toggles it renders; there is no toggle here, so the def's own value is the honest default.",

  "timeoutMs": 900000,
  "maxSteps": 120,

  "vars": {
    "geoModeDefName": "GeoscapeGameModeDef",
    "difficultyIndex": 1,
    "tutorial": false,
    "playIntroCinematic": false,
    "menuTimeoutMs": 120000,
    "loadTimeoutMs": 600000,
    "setupTimeoutMs": 300000
  },

  "steps": [
    { "//": "SAME HEAD AS start-mission.json, and for the same reasons - see the comments there.",
      "id": "phase", "verb": "state", "save": "ST0" },
    { "//LEAVING A GEOSCAPE": "See start-mission.json's `is-geoscape` for why these two steps exist and what wedges without them. A SECOND campaign in one session no longer needs a restarted game.",
      "id": "is-geoscape", "verb": "call", "save": "ISGEO",
      "args": { "op": "invoke", "type": "System.Object", "member": "Equals", "args": [ "geoscape", "${ST0.phase}" ] } },
    { "id": "geo-view", "verb": "call", "save": "GEOVIEW", "if": "${ISGEO.value}",
      "args": { "op": "get", "target": "@geo", "member": "View" } },
    { "id": "geo-stack-off", "verb": "call", "if": "${ISGEO.value}",
      "args": { "op": "set", "target": "${GEOVIEW.value.h}", "member": "UpdateStateStack", "value": false } },
    { "id": "geo-to-loading", "verb": "call", "if": "${ISGEO.value}",
      "args": { "op": "invoke", "target": "${GEOVIEW.value.h}", "member": "ToLoadingState", "args": [] } },
    { "id": "is-menu", "verb": "call", "save": "ISMENU",
      "args": { "op": "invoke", "type": "System.Object", "member": "Equals", "args": [ "menu", "${ST0.phase}" ] } },
    { "id": "in-level", "verb": "call", "save": "INLEVEL",
      "args": { "op": "invoke", "type": "System.Object", "member": "Equals", "args": [ false, "${ISMENU.value}" ] } },
    { "id": "to-menu", "verb": "call", "if": "${INLEVEL.value}",
      "args": { "op": "invoke", "target": "@phoenix", "member": "FinishLevelAndGoToLobby", "args": [ 0 ] } },
    { "id": "at-menu", "verb": "wait", "args": { "phase": "menu", "timeoutMs": "${menuTimeoutMs}", "everyFrames": 10 } },
    { "id": "menu-level-up", "verb": "wait",
      "args": { "timeoutMs": "${menuTimeoutMs}", "everyFrames": 10,
                "call": { "op": "get", "target": "@level", "member": "IsPlaying" } } },

    { "id": "find-mode", "verb": "find", "save": "MODE",
      "args": { "query": "${geoModeDefName}", "type": "PhoenixPoint.Common.Levels.GeoscapeGameModeDef" } },
    { "id": "mode-def", "verb": "call", "save": "MDEF",
      "args": { "op": "invoke", "target": "@defs", "member": "GetDef", "args": [ "${MODE.defs[0].guid}" ] } },
    { "//": "GameModeDef.LevelSceneBinding is a COMPUTED property (GeoscapeGameModeDef.cs:31) - every read builds a fresh binding off the def. One read, reused for both the params and the final CloneAndAddLevelParams.",
      "id": "binding", "verb": "call", "save": "BIND",
      "args": { "op": "get", "target": "${MDEF.value.h}", "member": "LevelSceneBinding" } },
    { "id": "def-params", "verb": "call", "save": "P0",
      "args": { "op": "get", "target": "${BIND.value.h}", "member": "LevelParams" } },
    { "id": "clone-params", "verb": "call", "save": "GP",
      "args": { "op": "invoke", "target": "${P0.value.h}", "member": "Clone", "args": [] } },

    { "id": "shared-data", "verb": "call", "save": "SD",
      "args": { "op": "invoke", "target": "@game", "member": "GetComponent",
                "typeArgs": [ "PhoenixPoint.Common.Core.SharedData" ], "args": [] } },
    { "id": "difficulties", "verb": "call", "save": "DIFFS",
      "args": { "op": "get", "target": "${SD.value.h}", "member": "DifficultyLevels" } },
    { "//": "The engine has no indexer; `items` with pageSize 1 IS the indexer. An out-of-range index returns zero items and the next step fails by name rather than picking a wrong difficulty.",
      "id": "difficulty", "verb": "items", "save": "DPAGE",
      "args": { "h": "${DIFFS.value.h}", "page": "${difficultyIndex}", "pageSize": 1 } },
    { "//": "READ IT NOW, not in the output tail. Loading the geoscape unloads a scene, and PPBridge bumps the handle epoch on every scene unload - every handle taken before `start` is a named refusal afterwards.",
      "id": "difficulty-name", "verb": "call", "save": "DNAME",
      "args": { "op": "get", "target": "${DPAGE.items[0].h}", "member": "name" } },
    { "id": "set-difficulty", "verb": "call",
      "args": { "op": "set", "target": "${GP.value.h}", "member": "Difficulty", "value": { "$h": "${DPAGE.items[0].h}" } } },
    { "id": "set-tutorial", "verb": "call",
      "args": { "op": "set", "target": "${GP.value.h}", "member": "TutorialEnabled", "value": "${tutorial}" } },
    { "//": "Not a menu option, but the difference between a campaign that is driveable in 40 s and one sitting behind an unskippable cinematic.",
      "id": "set-intro", "verb": "call",
      "args": { "op": "set", "target": "${GP.value.h}", "member": "PlayIntroCinematic", "value": "${playIntroCinematic}" } },
    { "//": "PhoenixGame.cs:940. NonSerialized and null on a fresh clone; the menu fills it in the same way.",
      "id": "extra-settings", "verb": "call", "save": "EGS",
      "args": { "op": "invoke", "target": "@phoenix", "member": "GetDefaultGameSettings", "args": [] } },
    { "id": "set-extra", "verb": "call",
      "args": { "op": "set", "target": "${GP.value.h}", "member": "ExtraGameSettings", "value": { "$h": "${EGS.value.h}" } } },

    { "id": "new-binding", "verb": "call", "save": "NBIND",
      "args": { "op": "invoke", "target": "${BIND.value.h}", "member": "CloneAndAddLevelParams",
                "args": [ { "$h": "${GP.value.h}" } ] } },
    { "id": "result", "verb": "call", "save": "RES",
      "args": { "op": "new", "type": "PhoenixPoint.Common.Levels.Params.PlayNewGameResult", "args": [] } },
    { "id": "result-binding", "verb": "call",
      "args": { "op": "set", "target": "${RES.value.h}", "member": "LevelSceneBinding", "value": { "$h": "${NBIND.value.h}" } } },
    { "//": "THE LEVER. PhoenixGame.cs:262-266; MenuCrt branches on the params TYPE into GeoscapeGameCrt (:526-530). Same call the Play button makes.",
      "id": "start", "verb": "call",
      "args": { "op": "invoke", "target": "@phoenix", "member": "FinishLevel", "args": [ { "$h": "${RES.value.h}" } ] } },

    { "id": "geoscape", "verb": "wait", "args": { "phase": "geoscape", "timeoutMs": "${loadTimeoutMs}", "everyFrames": 10 } },
    { "//": "AN HONEST COMPLETION PREDICATE. `phase:geoscape` only says the controller exists; WorldSetupRunning (GeoLevelController.cs:553,559) is false only once the world, the factions, the starting base and the initial squad have all been generated.",
      "id": "world-ready", "verb": "wait",
      "args": { "timeoutMs": "${setupTimeoutMs}", "everyFrames": 10, "not": true,
                "call": { "op": "get", "target": "@geo", "member": "WorldSetupRunning" } } },

    { "//": "PROOF IT IS PLAYABLE, not merely loaded. With instanceData null the game builds all of this itself (GeoLevelController.cs:543-563, GeoPhoenixFaction.cs:347-348) - if it did not, these read back empty.",
      "id": "phoenix-faction", "verb": "call", "save": "PF",
      "args": { "op": "get", "target": "@geo", "member": "PhoenixFaction" } },
    { "id": "starting-base", "verb": "call", "save": "BASE",
      "args": { "op": "get", "target": "${PF.value.h}", "member": "StartingBase" } },
    { "id": "characters", "verb": "call", "save": "CHARS",
      "args": { "op": "get", "target": "${PF.value.h}", "member": "Characters" } },
    { "id": "soldiers", "verb": "call", "save": "NSOLDIERS",
      "args": { "op": "invoke", "type": "System.Linq.Enumerable", "member": "Count",
                "typeArgs": [ "PhoenixPoint.Geoscape.Entities.GeoCharacter" ],
                "args": [ { "$h": "${CHARS.value.h}" } ] } },
    { "id": "vehicles", "verb": "call", "save": "VEHICLES",
      "args": { "op": "get", "target": "${PF.value.h}", "member": "Vehicles" } },
    { "id": "vehicle-count", "verb": "call", "save": "NVEHICLES",
      "args": { "op": "invoke", "type": "System.Linq.Enumerable", "member": "Count",
                "typeArgs": [ "PhoenixPoint.Geoscape.Entities.GeoVehicle" ],
                "args": [ { "$h": "${VEHICLES.value.h}" } ] } },
    { "id": "state", "verb": "state", "save": "ST" }
  ],

  "finally": [
    { "id": "release-chars", "verb": "release", "args": { "h": "${CHARS.value.h}" } },
    { "id": "release-vehicles", "verb": "release", "args": { "h": "${VEHICLES.value.h}" } },
    { "id": "release-diffs", "verb": "release", "args": { "h": "${DIFFS.value.h}" } },
    { "id": "release-shared-data", "verb": "release", "args": { "h": "${SD.value.h}" } },
    { "id": "release-result", "verb": "release", "args": { "h": "${RES.value.h}" } },
    { "id": "release-new-binding", "verb": "release", "args": { "h": "${NBIND.value.h}" } },
    { "id": "release-params", "verb": "release", "args": { "h": "${GP.value.h}" } },
    { "id": "release-binding", "verb": "release", "args": { "h": "${BIND.value.h}" } }
  ],

  "output": {
    "phase": "${ST.phase}",
    "scene": "${ST.scene}",
    "cameFrom": "${ST0.phase}",
    "difficultyIndex": "${difficultyIndex}",
    "difficulty": "${DNAME.value}",
    "difficulties": "${DIFFS.value.count}",
    "tutorial": "${tutorial}",
    "startingBase": "${BASE.value.name}",
    "soldiers": "${NSOLDIERS.value}",
    "vehicles": "${NVEHICLES.value}"
  }
}
